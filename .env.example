# Used only when the Users table is empty.
ABEARC_BOOTSTRAP_USERNAME=superadmin

# Optional: supply a temporary password of at least 12 characters through the
# deployment environment. Do not place a real password in this file.
# When omitted, ABEARC generates one and writes it to
# data/.bootstrap-admin-credentials with restricted file permissions.
# ABEARC_BOOTSTRAP_PASSWORD=
